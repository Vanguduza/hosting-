# Install as mode 0600 /etc/dial-hosting/postgres-physical-backup.env.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/dial-hosting/backup/restic-password
NODE_POSTGRES_IMAGE=
BACKUP_EVIDENCE_DIR=/var/lib/dial-hosting/backup/physical-evidence
BACKUP_PROBE_DIR=/etc/dial-hosting/backup/probes
# Add provider-specific Restic access credentials in this protected file.
