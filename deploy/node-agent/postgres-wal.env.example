# Install owner-only as /etc/dial-hosting/postgres-wal.env on each managed DB node.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/dial-hosting/postgres-restic-password
NODE_POSTGRES_IMAGE=
BACKUP_EVIDENCE_DIR=/var/lib/dial-hosting/backup/physical-evidence
BACKUP_PROBE_DIR=/etc/dial-hosting/postgres-restore-probes
POSTGRES_WAL_EVIDENCE_ROOT=/var/lib/dial-hosting/backup/wal-evidence
# Provider-specific Restic credentials belong in this owner-only file.
