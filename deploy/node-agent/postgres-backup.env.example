# Install as root-only /etc/dial-hosting/postgres-backup.env; do not commit values.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/dial-hosting/backup/restic-password
NODE_POSTGRES_IMAGE=
BACKUP_EVIDENCE_DIR=/var/lib/dial-hosting/backup/evidence
# Provider-specific Restic credentials belong in root-only EnvironmentFile entries.
