# Place as root-only /etc/dial-hosting/node-agent.env with actual private-node values.
NODE_BIND=
NODE_PORT=8443
NODE_CA_FILE=/etc/dial-hosting/tls/ca.pem
NODE_CERT_FILE=/etc/dial-hosting/tls/node.pem
NODE_KEY_FILE=/etc/dial-hosting/tls/node.key
NODE_CLIENT_CN=dial-control-worker
NODE_STATE_FILE=/var/lib/dial-hosting/node-agent/state.sqlite3
NODE_ROUTES_DIR=/var/lib/dial-hosting/node-agent/routes
NODE_SECRETS_DIR=/var/lib/dial-hosting/node-agent/secrets
NODE_RESERVE_MEMORY_MB=1024
NODE_RESERVE_CPU_MILLI=500
# Digest-pinned, tested PostgreSQL 17 image. Version and digest selected by operator.
NODE_POSTGRES_IMAGE=
# Digest-pinned, tested Valkey 9 image; no mutable tags in production.
NODE_VALKEY_IMAGE=
NODE_GARAGE_IMAGE=
