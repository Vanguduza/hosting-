# Install as root-only /etc/dial-hosting/storage-backup.env on a qualified storage node.
# Restic target must be off-host. Use separate repository credentials from live S3.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/dial-hosting/storage-restic-password
BACKUP_EVIDENCE_DIR=/var/lib/dial-hosting/storage-backup/evidence
BACKUP_TMP_DIR=/var/lib/dial-hosting/storage-backup/tmp
BACKUP_PROBE_DIR=/etc/dial-hosting/storage-probes
NODE_STATE_FILE=/var/lib/dial-hosting/node-agent/state.sqlite3
NODE_SECRETS_DIR=/var/lib/dial-hosting/node-agent/secrets
NODE_GARAGE_IMAGE=
NODE_STORAGE_SHELL_IMAGE=
NODE_AGENT_PACKAGE_DIR=/opt/dial-hosting/node-agent
