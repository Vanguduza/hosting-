# Install as owner-only /etc/dial-hosting/valkey-backup.env on a qualified Valkey node.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/dial-hosting/valkey-restic-password
BACKUP_EVIDENCE_DIR=/var/lib/dial-hosting/valkey-backup/evidence
BACKUP_TMP_DIR=/var/lib/dial-hosting/valkey-backup/tmp
BACKUP_PROBE_DIR=/etc/dial-hosting/valkey-probes
NODE_STATE_FILE=/var/lib/dial-hosting/node-agent/state.sqlite3
NODE_SECRETS_DIR=/var/lib/dial-hosting/node-agent/secrets
NODE_VALKEY_IMAGE=
NODE_STORAGE_SHELL_IMAGE=
NODE_AGENT_PACKAGE_DIR=/opt/dial-hosting/node-agent
