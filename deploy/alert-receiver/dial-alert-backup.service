[Unit]
Description=DIAL encrypted alert receiver backup and isolated restore
Wants=network-online.target
After=network-online.target dial-alert-receiver.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/dial-alert-receiver/restic.env
ExecStart=/usr/bin/python3 /opt/dial-hosting/alert-receiver/alert_receiver_backup.py backup-and-verify --config /etc/dial-alert-receiver/backup.json
StateDirectory=dial-alert-receiver
StateDirectoryMode=0700
TimeoutStartSec=2h
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
