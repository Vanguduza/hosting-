[Unit]
Description=DIAL durable operator alert delivery
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/dial-hosting/monitor-alert.env
ExecStart=/opt/dial-hosting/release-health-check/venv/bin/python /opt/dial-hosting/release-health-check/tools/operator_alerts.py dispatch
StateDirectory=dial-hosting-monitor
StateDirectoryMode=0700
TimeoutStartSec=2min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
