[Unit]
Description=DIAL public release observation freshness
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/dial-hosting/release-health-check.env
ExecStart=/opt/dial-hosting/release-health-check/venv/bin/python /opt/dial-hosting/release-health-check/tools/release_health_check.py --max-age-seconds ${MAX_AGE_SECONDS} --min-applications ${MIN_ACTIVE_APPLICATIONS}
TimeoutStartSec=1min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
