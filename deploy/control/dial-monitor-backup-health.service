[Unit]
Description=DIAL monitor alert queue restore freshness
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/dial-hosting/monitor-restic.env
ExecStart=/opt/dial-hosting/release-health-check/venv/bin/python /opt/dial-hosting/release-health-check/tools/alert_receiver_backup.py health --config /etc/dial-hosting/monitor-backup.json
StateDirectory=dial-hosting-monitor
StateDirectoryMode=0700
TimeoutStartSec=5min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
