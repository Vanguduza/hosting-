# Install as /etc/dial-hosting/control-backup.env, owned by root with mode 0600.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/dial-hosting/control-restic-password
BACKUP_EVIDENCE_DIR=/var/lib/dial-hosting/control-backup/evidence
PGHOST=
PGPORT=5432
PGUSER=
PGDATABASE=
PGPASSFILE=/etc/dial-hosting/control-pgpass
# Add the provider-specific Restic credentials as protected environment entries.
