# Development profile only. Supply a real HTTPS issuer and a dedicated audience.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_SERVICE_AUDIENCE=
OIDC_JWKS_URL=
# Optional public-client sign-in: set all four fields to enable it. No client secret.
OIDC_LOGIN_CLIENT_ID=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_LOGIN_REDIRECT_URI=
# Space-separated scopes including openid and the provider's API audience scope.
# Add offline_access when refresh tokens are permitted by the issuer.
OIDC_LOGIN_SCOPES=
