# Install owner-only as /etc/dial-hosting/control-wal.env on the selected backup host.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/dial-hosting/control-restic-password
CONTROL_WAL_SPOOL=/var/lib/dial-hosting/control-wal/spool
CONTROL_WAL_EVIDENCE=/var/lib/dial-hosting/control-wal/evidence
PGHOST=
PGPORT=5432
PGUSER=
PGDATABASE=hosting
PGPASSFILE=/etc/dial-hosting/control-pgpass
CONTROL_POSTGRES_IMAGE=
# Provider-specific Restic credentials belong in this owner-only file.
