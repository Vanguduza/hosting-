# Install as /etc/dial-hosting/openbao-backup.env, owner root, mode 0600.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/dial-hosting/openbao-restic-password
BACKUP_EVIDENCE_DIR=/var/lib/dial-hosting/openbao-backup/evidence
BAO_ADDR=https://bao.example.org:8200
BAO_CA_FILE=/etc/dial-hosting/openbao-ca.pem
BAO_BACKUP_TOKEN_FILE=/etc/dial-hosting/openbao-backup-token
BAO_PROBE_FILE=/etc/dial-hosting/openbao-backup-probe.json
# Add the provider-specific Restic access credentials as protected environment entries.
