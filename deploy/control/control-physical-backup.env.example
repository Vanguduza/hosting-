# Install as owner-only /etc/dial-hosting/control-physical-backup.env.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/dial-hosting/control-restic-password
BACKUP_EVIDENCE_DIR=/var/lib/dial-hosting/control-physical-backup/control-physical-evidence
PGHOST=
PGPORT=5432
PGUSER=
PGDATABASE=
PGPASSFILE=/etc/dial-hosting/control-pgpass
CONTROL_POSTGRES_IMAGE=
# Provider-specific Restic credentials belong in this owner-only file.
