# Install as root-owned mode 0600 at /etc/dial-hosting/release-health-check.env.
DB_HOST=
DB_NAME=hosting
DB_USER=hosting_worker
DB_PASSWORD_FILE=/etc/dial-hosting/health-db-password
# Set this to the minimum expected number of active deployed applications.
MIN_ACTIVE_APPLICATIONS=1
MAX_AGE_SECONDS=180
MIN_ENABLED_NODES=1
NODE_MAX_AGE_SECONDS=300
EVENT_MAX_AGE_SECONDS=300
EVENT_MAX_PENDING=1000
