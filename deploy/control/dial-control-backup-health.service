[Unit]
Description=DIAL control database verified backup freshness

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/dial-hosting/control-backup.env
ExecStart=/usr/bin/python3 /opt/dial-hosting/backup_health.py control ${BACKUP_EVIDENCE_DIR} --max-age-hours 36 --min-instances 1 --check-remote
NoNewPrivileges=yes
UMask=0077
