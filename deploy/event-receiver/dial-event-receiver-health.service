[Unit]
Description=DIAL independently persisted audit chain health

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/dial-event-receiver/receiver.env
ExecStart=/usr/bin/python3 /opt/dial-hosting/event-receiver/event_receiver.py health /etc/dial-event-receiver/signing-key /var/lib/dial-event-receiver/events.sqlite3
StateDirectory=dial-event-receiver
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
