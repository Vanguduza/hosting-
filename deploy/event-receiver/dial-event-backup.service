[Unit]
Description=DIAL encrypted audit event receiver backup and restore drill
Wants=network-online.target
After=network-online.target dial-event-receiver.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/dial-event-receiver/restic.env
ExecStart=/usr/bin/python3 /opt/dial-hosting/event-receiver/alert_receiver_backup.py backup-and-verify --config /etc/dial-event-receiver/backup.json
StateDirectory=dial-event-receiver
StateDirectoryMode=0700
TimeoutStartSec=2h
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
