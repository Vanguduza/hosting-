{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "partner-authority-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "id",
    "source_version_id",
    "intent_sha256",
    "sequence",
    "disposition",
    "hosting_entitlement_version_id",
    "admin_bindings",
    "issued_at",
    "valid_until",
    "evidence_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "purpose": {
      "const": "partner-commercial-bindings-v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "source_version_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "disposition": {
      "enum": [
        "AUTHORIZE",
        "REVOKE"
      ]
    },
    "hosting_entitlement_version_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "admin_bindings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "actor_sub"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "actor_sub": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "valid_until": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "^partner-proof://[A-Za-z0-9/_-]{1,120}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "AUTHORIZE"
          }
        }
      },
      "then": {
        "properties": {
          "hosting_entitlement_version_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "admin_bindings": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "hosting_entitlement_version_id": {
            "type": "null"
          },
          "valid_until": {
            "type": "null"
          },
          "admin_bindings": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
