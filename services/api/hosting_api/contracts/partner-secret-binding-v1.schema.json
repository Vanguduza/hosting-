{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hosting.dial.systems/contracts/partner-secret-binding-v1.schema.json",
  "title": "Protected Partner secret binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "organization_id",
    "application_id",
    "secret_ref",
    "bao_address",
    "bao_mount",
    "resource_id",
    "kv_version",
    "value_key",
    "enabled",
    "valid_from",
    "valid_until",
    "authorization_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "organization_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "application_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "secret_ref": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^secret://[a-z0-9][a-z0-9/_-]{0,190}#[1-9][0-9]{0,8}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "bao_address": {
      "type": "string",
      "pattern": "^https://[a-z0-9][a-z0-9.-]{0,252}(:[1-9][0-9]{0,4})?$",
      "maxLength": 270
    },
    "bao_mount": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "kv_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999999
    },
    "value_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "enabled": {
      "type": "boolean"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:0[0-9]|1[0-5]):[0-5][0-9])$",
      "not": {
        "pattern": "\\s"
      }
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:0[0-9]|1[0-5]):[0-5][0-9])$",
      "not": {
        "pattern": "\\s"
      }
    },
    "authorization_ref": {
      "type": "string",
      "pattern": "^secret-proof://[A-Za-z0-9/_-]{1,120}$"
    }
  }
}
