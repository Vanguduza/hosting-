{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "partner-authority-source-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "organization_id",
    "purpose",
    "name",
    "issuer",
    "client_id",
    "actor_sub",
    "enabled",
    "max_validity_seconds",
    "evidence_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "organization_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "purpose": {
      "const": "partner-commercial-bindings-v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "issuer": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~/-]*)?$"
    },
    "client_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "actor_sub": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "enabled": {
      "type": "boolean"
    },
    "max_validity_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "^authority://[A-Za-z0-9/_-]{1,120}$"
    }
  }
}
