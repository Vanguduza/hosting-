{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dial:hosting:execution-profile:1.0",
  "title": "Reviewed Partner hosting execution profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "organization_id",
    "template_id",
    "template_version",
    "environment_profile",
    "runtime_class",
    "release_artifact_ref",
    "backup_profile",
    "observability_profile",
    "database_profile",
    "storage_profile",
    "resource_ceiling",
    "node_bindings",
    "enabled",
    "valid_from",
    "valid_until",
    "qualification_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "organization_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "template_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "not": {
        "pattern": "\\s"
      }
    },
    "template_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "not": {
        "pattern": "\\s"
      }
    },
    "environment_profile": {
      "enum": [
        "development",
        "staging",
        "production"
      ]
    },
    "runtime_class": {
      "const": "docker-http-v1"
    },
    "release_artifact_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9./:_-]{1,240}@sha256:[a-f0-9]{64}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "backup_profile": {
      "const": "encrypted-offhost-v1"
    },
    "observability_profile": {
      "const": "release-health-v1"
    },
    "database_profile": {
      "enum": [
        "none",
        "postgres-private-v1"
      ]
    },
    "storage_profile": {
      "enum": [
        "none",
        "garage-development-v1"
      ]
    },
    "resource_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_milli",
        "memory_mb"
      ],
      "properties": {
        "cpu_milli": {
          "type": "integer",
          "minimum": 50,
          "maximum": 32000
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 64,
          "maximum": 32768
        }
      }
    },
    "node_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "configuration_sha256"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "not": {
              "pattern": "\\s"
            }
          },
          "configuration_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "not": {
              "pattern": "\\s"
            }
          }
        }
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:0[0-9]|1[0-5]):[0-5][0-9])$",
      "not": {
        "pattern": "\\s"
      }
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:0[0-9]|1[0-5]):[0-5][0-9])$",
      "not": {
        "pattern": "\\s"
      }
    },
    "qualification_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "runtime",
        "estate",
        "compatibility"
      ],
      "properties": {
        "template": {
          "type": "string",
          "pattern": "^template-proof://[A-Za-z0-9/_-]{1,120}$",
          "not": {
            "pattern": "\\s"
          }
        },
        "runtime": {
          "type": "string",
          "pattern": "^runtime-proof://[A-Za-z0-9/_-]{1,120}$",
          "not": {
            "pattern": "\\s"
          }
        },
        "estate": {
          "type": "string",
          "pattern": "^estate-proof://[A-Za-z0-9/_-]{1,120}$",
          "not": {
            "pattern": "\\s"
          }
        },
        "compatibility": {
          "type": "string",
          "pattern": "^compatibility-proof://[A-Za-z0-9/_-]{1,120}$",
          "not": {
            "pattern": "\\s"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "storage_profile": {
            "const": "garage-development-v1"
          }
        }
      },
      "then": {
        "properties": {
          "environment_profile": {
            "const": "development"
          }
        }
      }
    }
  ]
}
