{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dial:hosting:intent:1.0",
  "title": "DIAL Partner HostingIntent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "partner_id",
    "dial_business_account_id",
    "project_id",
    "template_id",
    "template_version",
    "environment_profile",
    "runtime_class",
    "domain_intent",
    "database_profile",
    "storage_profile",
    "backup_profile",
    "observability_profile",
    "resource_budget",
    "release_artifact_ref",
    "secret_refs",
    "tenant_admin_refs",
    "commercial_entitlement_ref",
    "requested_by",
    "request_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "partner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "dial_business_account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "template_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "template_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "environment_profile": {
      "enum": [
        "development",
        "staging",
        "production"
      ]
    },
    "runtime_class": {
      "const": "docker-http-v1"
    },
    "domain_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostname"
      ],
      "properties": {
        "hostname": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z][a-z0-9-]{1,62}$"
        }
      }
    },
    "database_profile": {
      "enum": [
        "none",
        "postgres-private-v1",
        "supabase-unqualified"
      ]
    },
    "storage_profile": {
      "enum": [
        "none",
        "garage-development-v1",
        "s3-redundant-unqualified"
      ]
    },
    "backup_profile": {
      "const": "encrypted-offhost-v1"
    },
    "observability_profile": {
      "const": "release-health-v1"
    },
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_milli",
        "memory_mb"
      ],
      "properties": {
        "cpu_milli": {
          "type": "integer",
          "minimum": 50,
          "maximum": 32000
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 64,
          "maximum": 32768
        }
      }
    },
    "release_artifact_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9./:_-]{1,240}@sha256:[a-f0-9]{64}$"
    },
    "secret_refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 256,
        "pattern": "^secret://[a-z0-9][a-z0-9/_-]{0,190}#[1-9][0-9]{0,8}$"
      }
    },
    "tenant_admin_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
      }
    },
    "commercial_entitlement_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "requested_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
